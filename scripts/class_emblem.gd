	"debt":[".######.",".#....#.",".#.##.#.",".#..#.#.",".#.##.#.",".#....#.",".######.","..#.#..."],
	"lantern":["...##...","..####..",".######.",".#.##.#.",".#.##.#.",".#....#.",".######.","..####.."],
	"gravity":["...##...","..####..","...##...",".#.##.#.","..####..","...##...",".######.","########"],
