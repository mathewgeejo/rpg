}
var class_id = "luck"
var color = Color("dfbd76")
var animated = false
var time = 0.0

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	set_process(animated)

func _process(delta: float) -> void:
	time += delta
	queue_redraw()

func _draw() -> void:
	var cell = floorf(minf(size.x,size.y)/12)
	var origin = ((size-Vector2.ONE*cell*8)*.5).floor()
	var pattern: Array = GLYPHS.get(class_id,GLYPHS.luck)
	for y in 8:
		for x in 8:
			if pattern[y][x] == "#":
				var point = origin+Vector2(x,y)*cell
				draw_rect(Rect2(point+Vector2(0,cell*.25),Vector2.ONE*cell),Color("30364f"))
				draw_rect(Rect2(point,Vector2.ONE*cell),color)
	if animated:
		for i in 8:
			var angle = i*TAU/8+floorf(time*6)*.06
			var p = (size*.5+Vector2.from_angle(angle)*cell*5.4).round()
			draw_rect(Rect2(p,Vector2.ONE*maxf(2,cell*.2)),Color(color,.6))
